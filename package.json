{
  "name": "graffgrid-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "portfolio",
    "projects/apex",
    "projects/kasicart"
  ],
  "scripts": {
    "dev": "npm --workspace=portfolio run dev",
    "dev:portfolio": "npm --workspace=portfolio run dev",
    "dev:apex": "npm --workspace=apex-facilities-group run dev",
    "dev:kasicart": "npm --workspace=kasicart run dev",
    "build:portfolio": "npm --workspace=portfolio run build",
    "build:apex": "npm --workspace=apex-facilities-group run build",
    "build:kasicart": "npm --workspace=kasicart run build",
    "build": "npm --workspace=portfolio run build && npm --workspace=apex-facilities-group run build && npm --workspace=kasicart run build && node assemble-dist.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
