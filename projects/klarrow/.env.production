# Klarrow app build environment (GraffGrid embedding).
# VITE_API_BASE points the workbench UI at the hosted .NET engine (Render deployment
# of Just4Skii/Klarrow). Empty string would mean same-origin /api (local dev uses the
# Vite proxy instead, so this file only affects production builds).
VITE_API_BASE=https://klarrow.onrender.com

# Public demo guards (also enforced server-side by Demo__PublicMode): hide upload
# affordances in this public copy of the UI.
VITE_PUBLIC_DEMO=1
